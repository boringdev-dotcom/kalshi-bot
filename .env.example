# Kalshi API
# Portal: https://trading-api.kalshi.com/trade-api-portal/
KALSHI_API_KEY_ID=your_api_key_id_here
KALSHI_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----

# demo | prod. Paper mode is independent of host.
KALSHI_ENV=demo
# Optional overrides
# KALSHI_API_BASE_URL=https://demo-api.kalshi.co
# KALSHI_WS_URL=wss://demo-api.kalshi.co/trade-api/ws/v2

# Trading
# Paper is the default. Set PAPER_MODE=false only when you intend to send live orders.
PAPER_MODE=true
TRADING_PAUSED=false

# xAI / Grok (agents only; watcher is non-agentic)
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4-1-fast
XAI_INPUT_PRICE_PER_MTOK=0.20
XAI_OUTPUT_PRICE_PER_MTOK=0.50

# Telegram (notifications + /games /held /status /pause /resume)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Persistence
SQLITE_PATH=data/kalshi_bot.sqlite

# API / dashboard
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Watcher
DISCOVERY_INTERVAL_SEC=1800
POLL_INTERVAL_SEC=15
PREMATCH_LEAD_SEC=900
WATCH_HORIZON_HOURS=6
