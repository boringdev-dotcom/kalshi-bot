# Courtside configuration. Copy to .env and fill in what you have.
# The app runs with none of these set: simulated games + paper trading.

# --- Kalshi (needed for live trading; market data is public) ---
KALSHI_API_KEY_ID=
# RSA private key, PEM. Single line with \n for newlines is fine.
KALSHI_PRIVATE_KEY_PEM=
# demo | prod
KALSHI_ENV=prod

# --- Claude (the agent's reasoning, chat, guidance and reflection) ---
ANTHROPIC_API_KEY=
# Deep work: chat, interpreting your guidance, post-trade reflection.
CLAUDE_MODEL=claude-opus-5-5
# Fast pre-trade review inside the live loop.
CLAUDE_FAST_MODEL=claude-haiku-5-5

# --- FanDuel odds via The Odds API (https://the-odds-api.com) ---
ODDS_API_KEY=

# --- Hosting ---
# Password for the web UI. Required on a public host (the app stays locked
# without it); optional on your own machine.
APP_PASSWORD=

# --- Local ---
DB_PATH=data/courtside.db
PAPER_STARTING_CASH=5000
